<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane styleClass="dashboard-root" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="OnlineBanking.TransferController">
   <children>
      <AnchorPane layoutX="50.0" layoutY="50.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" styleClass="account-card" stylesheets="@../style/style.css">
         <children>
            <VBox layoutX="150.0" layoutY="50.0" prefHeight="300.0" prefWidth="200.0" spacing="15.0">
               <children>
                  <Label text="Transfer Funds" textFill="SILVER">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="recipientIdField" promptText="Recipient Account Number" styleClass="navy-input" />
                  <TextField fx:id="amountField" promptText="Amount ($)" styleClass="navy-input" />
                  <TextField fx:id="noteField" promptText="Note (e.g. Rent, Groceries)" styleClass="navy-input" />
                  <Button fx:id="sendMoneyButton" mnemonicParsing="false" onAction="#handleTransfer" styleClass="silver-button" text="Send Transfer" />
                  <Label fx:id="transferStatusLabel" prefWidth="300.0" styleClass="success-label" wrapText="true">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
